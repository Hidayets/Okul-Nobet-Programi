# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: JWT imzalama için kullanılan gizli anahtar.
# Bu örnek değer bırakılırsa yok sayılır; sunucu kendine özel rastgele bir anahtar üretip saklar.
# Değiştirildiğinde tüm aktif oturumlar geçersiz olur.
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# SUPER_ADMIN_KEY: Özel (süper yönetici) giriş anahtarı.
# Belirtilmezse gömülü varsayılan anahtar (342665) kullanılır; yani özel giriş her kurulumda
# etkindir. Belirli bir kurulumda farklı bir anahtar kullanmak isterseniz buraya yazın.
# SUPER_ADMIN_KEY=""

# LICENSE_SECRET: Lisans anahtarı üretimi/doğrulaması için HMAC gizli anahtarı.
# ÖNEMLİ:
#   1) Bu değer server.ts ve generate-license.cjs içindeki varsayılanla AYNI olmalıdır
#      (aynı .env dosyası okunduğu sürece otomatik aynı olur).
#   2) Değiştirirseniz daha önce üretilmiş TÜM lisans anahtarları geçersiz olur.
#   3) Bu değeri kimseyle paylaşmayın; gizli kalmazsa lisans korumanız anlamsızlaşır.
LICENSE_SECRET="okul-nobet-2025-BURAYA-KENDI-GIZLI-ANAHTARINIZI-YAZIN"

# Lisans listesinin durduğu özel GitHub deposu. LICENSE_SECRET buraya yazılmaz.
# Anahtar: GitHub > Settings > Developer settings > Personal access tokens
# Classic token için "repo" izni yeterlidir. Depo Private olmalıdır.
# LICENSE_GITHUB_REPO="kullanici-adiniz/okul-lisanslari"
# LICENSE_GITHUB_TOKEN=""
